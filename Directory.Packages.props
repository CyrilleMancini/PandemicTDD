<Project>
  <PropertyGroup>
    <!-- Active le CPM -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <MicrosoftVersion>[10.0.15, 11.0.0)</MicrosoftVersion>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!--<PackageVersion Include="bunit" Version="2.9.0" />-->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.2" />
    <PackageVersion Include="MSTest.TestAdapter" Version="4.5.3" />
    <PackageVersion Include="MSTest.TestFramework" Version="4.5.3" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- PandemicClientBlazor -->
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="$(MicrosoftVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="$(MicrosoftVersion)" PrivateAssets="all" />
    <PackageVersion Include="System.Net.Http.Json" Version="$(MicrosoftVersion)" />
  </ItemGroup>
</Project>