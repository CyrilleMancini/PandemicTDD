<Project>
	<PropertyGroup>
		<!-- Active le CPM -->
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
		<MicrosoftVersion>10.0.9</MicrosoftVersion>
		<CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
	</PropertyGroup>
	<ItemGroup>
		<!--<PackageVersion Include="bunit" Version="2.9.0" />-->
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.0.0" />
		<PackageVersion Include="MSTest.TestAdapter" Version="2.2.8" />
		<PackageVersion Include="MSTest.TestFramework" Version="2.2.8" />
		<PackageVersion Include="coverlet.collector" Version="3.1.0"/>
	</ItemGroup>

	<ItemGroup>
		<!-- PandemicClientBlazor -->
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="5.0.12" />
		<PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="5.0.12" PrivateAssets="all" />
		<PackageVersion Include="System.Net.Http.Json" Version="5.0.0" />
	</ItemGroup>
</Project>