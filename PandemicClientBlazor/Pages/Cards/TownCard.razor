<div class="card-background" style="background-color:@Card.Town.Color">
    <div class="card-background-sub">

        <div class="town-name @(TownColors[Card.Town.Color])">@Card.Town.Name</div>
        <div class="country-name">@Card.Town.Country</div>
        <div class="card-map">Ma p</div>
    </div>
</div>


@code {
    readonly static Dictionary<DiseaseColor, string> TownColors = new()
    {
        { DiseaseColor.Black,"card-black"},
        { DiseaseColor.Red,"card-red"},
        { DiseaseColor.Blue,"card-blue"},
        { DiseaseColor.Yellow,"card-yellow"},
    };


    [Parameter]
    public PlayerTownCard Card { get; set; }
}

