<button @onclick="() => Hidden = !Hidden">DBG</button>
<div class="debug-panel" style="visibility:@(Hidden ? "hidden" : "visibe")">
    <h4>DebugPanel</h4>
    <ul>
        <h5>Mouse</h5>
        <li id="mouse-position">
            plop
        </li>  @foreach (var k in DebugActions.Keys)
        {
            <li>
                <button @onclick="() => DebugActions[k]()">@k</button>
            </li>
        }

        <h4>Traces</h4>

        @foreach (string msg in Logs)
        {
            <li>@msg</li>
        }
        
    </ul>

</div>

<script lang="Javascript">

    
    addEventListener("mousedown", (event) => {
            console.log(event);
        if(event.buttons == 1 ){
            document.getElementById("mouse-position").innerHTML = "X="+event.clientX + ",Y="+event.clientY;
            navigator.clipboard.writeText(event.clientX+","+event.clientY);
        }
    });

</script>
