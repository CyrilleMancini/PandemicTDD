@if (GameState != null)
{
    @foreach (TownSlot slot in GameState.Board.GetTownSlots())
    {
        UiTownItem pos = position.Positions[slot.Town.Name];
        string labelclass = "town-label-" + slot.Town.Name.ToLower().Replace(" ", "_");

        <!-- Displays town's target -->
        <div class="town-target" style="top:@(pos.Y - 16)px;left:@(pos.X - 16)px;background-color:@slot.Town.Color">
        </div>

        <!-- Displays town's labels -->
        <div class="town-label @(labelclass)">
            @slot.Town.Name
            <br />
            @if (GameState?.Players != null)
            {

                @foreach (var player in GameState.Players)
                {
                    if (player.Town.Name == slot.Town.Name)
                    {
                        string userTownClass = "town-label-" + player.Town.Name.ToLower().Replace(" ", "_");
                        if (player == GameState.CurrentPlayer)
                        {
                            userTownClass += " player-active";
                        }
                        <div>
                            <div class="player-svg @(userTownClass)">
                            </div>
                            <div class="player-name" style="font-size:small">
                                @player.Name
                            </div>
                            <span class="player-info">
                                @player.Role.Name
                            </span>
                        </div>
                        <br />
                    }
                }
            }
        </div>
    }
}
